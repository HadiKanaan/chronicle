backend/data/*.sqlite
backend/data/*.sqlite3
frontend/dist/
# Day 9: backend-side Azure TTS disk cache (synthesized mp3s, regenerable)
backend/data/tts_cache/

# Day 9 audio assets: the OST source mp3s at the CHRONICLE root and the slugged
# copies the setup script lays down under the public audio dir, plus any CC0
# ambient clips the user drops in. Treated like the sprite packs - regenerable
# from the source mp3s via tools/setup_assets.py, so they stay out of git.
**/*.mp3
**/*.ogg
**/*.wav
frontend/public/assets/audio/

# Day 10 UI assets: the bundled pixel webfonts and the optional 9-slice frame
# PNG laid down under frontend/public/assets/ui/. Treated like every other asset
# layer - regenerable via tools/setup_assets.py (copy_fonts) and gitignored, so
# a fresh checkout falls back to the CSS frame + monospace stack with no FOUT.
**/*.woff
**/*.woff2
**/*.ttf
**/*.otf
frontend/public/assets/ui/

# Pixel art and source art assets
Pixel Crawler - Free Pack/
**/*.ase
**/*.aseprite
**/*.psd
**/*.kra
**/*.xcf
**/*.png
**/*.jpg
**/*.jpeg
**/*.gif
**/*.webp
**/*.bmp
